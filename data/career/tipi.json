    "T9": {
      "en": "Calm, emotionally stable",
      "ru": "Спокойствие, эмоциональная устойчивость"
    },
    "T10": {
      "en": "Conventional, uncreative",
      "ru": "Приверженность привычному, отсутствие тяги к творчеству"
